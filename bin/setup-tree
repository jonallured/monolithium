#!/bin/sh
set -e

main_checkout="${1:?usage: bin/setup-tree <main checkout>}"
task_id="${TASKMASTER_TASK_ID:?TASKMASTER_TASK_ID is not set}"

[ -f .env ] || cp "$main_checkout/.env" .env
grep -q '^MONOLITHIUM_DB_SUFFIX=' .env || printf '\nMONOLITHIUM_DB_SUFFIX=_%s\n' "$task_id" >>.env

bundle check >/dev/null || bundle install
bin/rails db:prepare
RAILS_ENV=test bin/rails db:prepare
bin/rails tailwindcss:build
