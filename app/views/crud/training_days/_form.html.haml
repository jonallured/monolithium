= form_with model: [:crud, training_day] do |form|
  = form.date_field :date, placeholder: "date"
  = form.select :intensity, TrainingDay::INTENSITIES, include_blank: "please select", selected: training_day.intensity
  = form.select :with_coach, [true, false], include_blank: "please select", selected: training_day.with_coach
  = form.datetime_local_field :completed_at, placeholder: "completed at"
  = form.button button_label
